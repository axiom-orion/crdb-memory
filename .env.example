# CockroachDB Cloud — tinted-guppy (crdbmemory database)
# Get the password from: Console > tinted-guppy > SQL Users > crdbmemory_svc
DATABASE_URL=postgresql://crdbmemory_svc:<PASSWORD>@tinted-guppy-30294.j77.aws-us-east-1.cockroachlabs.cloud:26257/crdbmemory?sslmode=verify-full

# Local 3-node Docker cluster (roach1/roach2/roach3), used only for the
# node-kill resilience demo — see scripts/local_cluster.sh
DATABASE_URL_LOCAL=postgresql://root@localhost:26258/crdbmemory?sslmode=disable

# LLM backend: "live" for real Claude + Gemini calls, "mock" for offline dev/CI (default)
LLM_BACKEND=mock

# Chat/reasoning — Claude, via the Anthropic SDK's own credential resolution
# (ANTHROPIC_API_KEY / ANTHROPIC_AUTH_TOKEN / an `ant auth login` profile).
# No key stored here.
CHAT_MODEL=claude-opus-5

# Embeddings — Gemini (Claude has no embeddings endpoint)
GEMINI_API_KEY=
EMBED_MODEL=gemini-embedding-001
EMBED_DIM=1024

# AWS — S3 durability backstop for the memory ledger
AWS_REGION=us-east-1
S3_ARCHIVE_BUCKET=
